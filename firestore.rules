rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myDoc().data.role == 'admin';
    }

    // Shop data: anyone can read, only admin can change
    match /products/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /categories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}   { allow read: if true; allow write: if isAdmin(); }

    // Users: you can read/edit yourself but never change your own role
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'customer';
      allow update: if signedIn() && ((request.auth.uid == uid
                    && request.resource.data.role == resource.data.role) || isAdmin());
    }

    // Orders
    match /orders/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid
                  || resource.data.assignedTo == request.auth.uid
                  || isAdmin());

      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'placed'
                    && request.resource.data.paymentMethod == 'COD'
                    && (!exists(/databases/$(database)/documents/settings/store)
                        || get(/databases/$(database)/documents/settings/store).data.get('isOpen', true) == true)
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 60;

      allow update: if isAdmin()
        // customer can cancel their own order while it is still "placed"
        || (signedIn() && resource.data.userId == request.auth.uid
            && resource.data.status == 'placed'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        // delivery person can only update their own assigned orders
        || (signedIn() && resource.data.assignedTo == request.auth.uid
            && request.resource.data.status in ['out_for_delivery', 'delivered']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cashCollected', 'updatedAt']));
    }
  }
}
